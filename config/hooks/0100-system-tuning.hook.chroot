#!/bin/sh
# live-build chroot hook: system/service tuning for lightweight, fast boot.
# Runs inside the chroot during `lb build`.

set -e

# ---- Mask services we don't want starting by default ----
for svc in \
    bluetooth.service \
    cups.service \
    ModemManager.service \
    avahi-daemon.service \
    rsyslog.service \
    unattended-upgrades.service \
    network-manager-wait-online.service \
    systemd-networkd-wait-online.service \
    preload.service ; do
    if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
        systemctl mask "$svc" 2>/dev/null || true
    fi
done

# ---- Enable services we DO want ----
for svc in \
    seatd \
    systemd-timesyncd \
    systemd-resolved \
    NetworkManager \
    cron \
    zram-generator ; do
    if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
        systemctl enable "$svc" 2>/dev/null || true
    fi
done

# ---- journald limits ----
mkdir -p /etc/systemd/journald.conf.d
cat > /etc/systemd/journald.conf.d/99-macos-lite.conf <<'EOF'
[Journal]
Storage=auto
Compress=yes
SystemMaxUse=50M
SystemKeepFree=100M
MaxRetentionSec=7day
MaxFileSec=1day
EOF

# ---- sysctl tuning ----
mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/99-macos-lite.conf <<'EOF'
vm.swappiness = 10
vm.vfs_cache_pressure = 50
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
EOF

# ---- zram config ----
mkdir -p /etc/systemd/zram-generator.conf.d
cat > /etc/systemd/zram-generator.conf.d/99-macos-lite.conf <<'EOF'
[zram0]
zram-size = min(ram, 4096)
compression-algorithm = zstd
EOF

# ---- Disable getty on unused VTs (keep tty1 only) ----
for v in tty2 tty3 tty4 tty5 tty6; do
    if [ -e "/etc/systemd/system/getty.target.wants/getty@$v.service" ]; then
        rm -f "/etc/systemd/system/getty.target.wants/getty@$v.service"
    fi
done

# ---- Timezone & locale defaults ----
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
echo "LANG=en_US.UTF-8" > /etc/default/locale
locale-gen

echo "[0100-system-tuning] done"
